# ============================================================
# Resume Intelligence Analyzer - Environment Configuration
# ============================================================
# Copy this file to ".env" and fill in your real values.
# NEVER commit a real .env file with secrets to source control.

# --------------------------------------------------------------
# Which LLM backend to use.
#   anthropic   -> calls Claude directly (needs ANTHROPIC_API_KEY)
#   openrouter  -> calls any OpenRouter-hosted model, e.g. DeepSeek,
#                  Grok, Llama (needs OPENROUTER_API_KEY)
# Any value other than "anthropic" is routed through OpenRouter.
# --------------------------------------------------------------
LLM_PROVIDER=openrouter

# --- OpenRouter settings (used when LLM_PROVIDER is not "anthropic") ---
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Any OpenRouter model id works here, e.g.:
#   deepseek/deepseek-chat-v3-0324
#   x-ai/grok-2-latest
#   meta-llama/llama-3.3-70b-instruct
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324
OPENROUTER_MAX_TOKENS=8000
OPENROUTER_TEMPERATURE=0.3

# --- Anthropic settings (used when LLM_PROVIDER=anthropic) ---
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MAX_TOKENS=8000

# --- Streamlit run configuration (optional) ---
STREAMLIT_SERVER_PORT=8501
